{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"cd api && bun run dev\" --names \"vite,api\" --prefix-colors \"cyan,magenta\"",
    "dev:tunnel": "concurrently \"vite\" \"cd api && bun run dev\" \"cloudflared tunnel --config api/cloudflared.yml run\" --names \"vite,api,tunnel\" --prefix-colors \"cyan,magenta,yellow\"",
    "dev:web": "vite",
    "push:schema": "bun --env-file=api/.env scripts/push-instant.ts schema",
    "push:perms": "bun --env-file=api/.env scripts/push-instant.ts perms",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@instantdb/core": "^0.22.171",
    "@instantdb/react": "^0.22.171",
    "@tanstack/react-router": "^1.168.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/router-devtools": "^1.166.11",
    "@tanstack/router-plugin": "^1.167.5",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  }
}
