{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "5524ca952e19f724ad83773cd80c1bbb",
  "name": "dotlock",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-11",
  "observability": {
    "enabled": true
  },
  "placement": { "mode": "smart" },
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
